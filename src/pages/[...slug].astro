---
import { resolveRoute } from "@/lib/routes/router";

import NotFound from "@/page/Page404.astro";
import Layout from "@/com/layout/Layout.astro";

const { slug } = Astro.params;

// 라우트 노드 찾기
const routeConfig = resolveRoute(slug);

// 매칭되지 않는 주소일 경우 404 상태 코드 반환
if (!routeConfig) {
    Astro.response.status = 404;
}

// 3. 렌더링할 타겟 컴포넌트 및 페이지 메타 정보 설정
const TargetView = routeConfig ? routeConfig.view : NotFound;
const pageTitle = routeConfig ? routeConfig.title : "페이지를 찾을 수 없습니다";
const pageDescription = routeConfig
    ? routeConfig.description
    : "요청하신 페이지가 존재하지 않습니다.";
---

{/* 4. 최상위에서 Layout으로 전체 감싸기 */}
<Layout title={pageTitle} description={pageDescription}>
    <TargetView {...routeConfig} />
</Layout>
