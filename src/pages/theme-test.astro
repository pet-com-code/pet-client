---
import Layout from "@/com/layout/Layout.astro";
// import ThemeToggle from "@/comps/theme/ThemeToggleCSS.astro";
import { SITE_CONFIG } from "@/lib/site";
---

<Layout title="테마 테스트" description="테마 변경 기능 체크 페이지">
    <div>
        <!-- <ThemeToggle /> -->

        <!-- 테마 변경 버튼 영역 -->
        <div style="padding: 1rem; display: flex; gap: 0.5rem;">
            <button
                type="button"
                class="btn-theme"
                onclick="changeTheme('general')">기본</button
            >
            <button type="button" class="btn-theme" onclick="changeTheme('dog')"
                >🐶 강아지</button
            >
            <button type="button" class="btn-theme" onclick="changeTheme('cat')"
                >🐱 고양이</button
            >
        </div>

        <!-- 카드 예시 -->
        <div
            class="shadow-card"
            style="padding: 2rem; margin: 1rem; border-radius: 0.5rem; background: var(--color-base-200);"
        >
            <h2>테마 적용 카드리스트</h2>
            <p>현재 테마 변수가 자동으로 변경됩니다.</p>
        </div>
    </div>
</Layout>

<!-- 💡 define:vars와 is:inline을 함께 사용하여 전역 window 객체에 함수 등록 -->
<script
    is:inline
    define:vars={{
        COOKIE_KEY: SITE_CONFIG.theme.cookieKey,
        STORAGE_KEY: SITE_CONFIG.theme.storageKey
    }}
>
    // onclick 속성에서 접근 가능하도록 window 객체에 직접 함수 할당
    window.changeTheme = function (themeName) {
        // [디버깅 1] 버튼 클릭 이벤트 수신 확인
        console.log("👉 [Theme Check] 클릭된 테마:", themeName);

        try {
            // 1. HTML data-theme 속성 변경
            document.documentElement.setAttribute("data-theme", themeName);

            // [디버깅 2] DOM 적용 확인
            const updatedTheme =
                document.documentElement.getAttribute("data-theme");
            console.log("✅ [Theme Check] DOM 적용 결과:", updatedTheme);

            // 2. LocalStorage 및 Cookie 동기화 저장
            localStorage.setItem(STORAGE_KEY, themeName);
            document.cookie = `${COOKIE_KEY}=${themeName}; path=/; max-age=31536000; SameSite=Lax`;

            console.log("💾 [Theme Check] 저장 성공 (Storage/Cookie)");
        } catch (error) {
            console.error("❌ [Theme Check] 테마 변경 중 에러 발생:", error);
        }
    };

    // [디버깅 3] 스크립트 로드 완료 및 함수 등록 여부 체크
    console.log(
        "🚀 [Theme Check] changeTheme 함수 등록 완료:",
        typeof window.changeTheme
    );
</script>
