---
// src/layouts/LayoutCenter.astro
const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
    </head>
    <body>
        <div class="center-container">
            <slot />
            <!-- 여기에 index.astro의 내용이 들어갑니다 -->
        </div>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden; /* 레이아웃 차원에서 스크롤바 원천 차단 */
        background-color: #ffffff;
    }
    .center-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>
