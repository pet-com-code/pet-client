---
// src/components/Footer.astro

const siteType = Astro.locals.siteType || "SHOP";
const currentYear = new Date().getFullYear();

// 교차 사이트 이동 링크 생성
const DOMAIN_SHOP = import.meta.env.PUBLIC_DOMAIN_SHOP || "petshop";
const DOMAIN_FIND = import.meta.env.PUBLIC_DOMAIN_FIND || "petfind";
const isLocal = import.meta.env.DEV;

const shopUrl = isLocal
    ? `http://${DOMAIN_SHOP}:4321`
    : `https://${DOMAIN_SHOP}.com`;
const findUrl = isLocal
    ? `http://${DOMAIN_FIND}:4321`
    : `https://${DOMAIN_FIND}.com`;
---

<footer class="site-footer">
    <div class="footer-container">
        <!-- 1. 상단 약관 및 사이트 스위치 링크 -->
        <div class="footer-top">
            <ul class="terms-list">
                <li><a href="/terms">이용약관</a></li>
                <li>
                    <a href="/privacy" class="privacy-link">개인정보처리방침</a>
                </li>
                {
                    siteType === "SHOP" ? (
                        <>
                            <li>
                                <a href="/guide/shipping">배송/반품안내</a>
                            </li>
                            <li>
                                <a href="/guide/shopping">쇼핑몰 이용안내</a>
                            </li>
                        </>
                    ) : (
                        <>
                            <li>
                                <a href="/guide/report">실종 제보 수칙</a>
                            </li>
                            <li>
                                <a href="/guide/adopt">입양/분양 가이드</a>
                            </li>
                        </>
                    )
                }
            </ul>

            <!-- 패밀리 사이트 이동 버튼 -->
            <a
                href={siteType === "SHOP" ? findUrl : shopUrl}
                class="family-site-btn"
            >
                {
                    siteType === "SHOP"
                        ? "🔍 찾아주기·분양 사이트 바로가기"
                        : "🛍️ 펫줍 쇼핑몰 바로가기"
                }
            </a>
        </div>

        <!-- 2. 메인 정보 (고객센터 & 사업자 정보) -->
        <div class="footer-body">
            <!-- CS 고객센터 섹션 -->
            <div class="cs-section">
                <h3 class="section-title">
                    {
                        siteType === "SHOP"
                            ? "🛒 쇼핑몰 고객센터"
                            : "🚨 실종·제보 센터"
                    }
                </h3>
                <p class="cs-number">1588-0000</p>
                <div class="cs-hours">
                    <p>운영시간: 평일 09:00 ~ 18:00 (점심시간 12:00 ~ 13:00)</p>
                    <p>
                        주말 및 공휴일 휴무 (찾아주기 제보는 24시간 등록 가능)
                    </p>
                    <p>이메일: help@petjup.com</p>
                </div>
            </div>

            <!-- 사업자 등록 정보 섹션 -->
            <div class="company-section">
                <p class="company-name">(주)펫.닷컴 컴퍼니</p>
                <p>
                    대표자: 홍길동 | 사업자등록번호: 000-00-00000
                    <a href="#" class="underline-link">사업자정보확인</a>
                </p>
                <p>
                    통신판매업신고: 2026-서울강남-0000호 | 개인정보보호책임자:
                    김철수
                </p>
                <p>주소: 서울특별시 강남구 테헤란로 123 펫줍타워 5층</p>

                {
                    siteType === "SHOP" ? (
                        <p class="legal-notice">
                            (주)펫.닷컴은 통신판매중개자로서 통신판매의 당사자가
                            아니며, 입점업체가 등록한 상품, 거래정보 및 거래에
                            대해 책임을 지지 않습니다.
                        </p>
                    ) : (
                        <p class="legal-notice">
                            펫.닷컴 찾아주기·분양 서비스는 유기동물 보호 및
                            무료/합법 분양 정보 매개 플랫폼으로, 허위 제보 및
                            불법 매매 게시물 등록 시 관련 법률에 따라 처벌받을
                            수 있습니다.
                        </p>
                    )
                }
            </div>
        </div>

        <!-- 3. 카피라이트 -->
        <div class="footer-bottom">
            <p>© {currentYear} PETJOOP Corp. All rights reserved.</p>
        </div>
    </div>
</footer>
<style>
    .site-footer {
        width: 100%; /* 브라우저 좌우 끝까지 배경색을 채움 */
        margin-top: auto;
        border-top: 1px solid var(--border-base-200, #e5e7eb);
        background-color: var(--bg-base-100, #ffffff);
        color: var(--text-base-content, #1f2937);
        opacity: 0.8;
        font-size: 0.875rem; /* text-sm */
    }

    .footer-container {
        width: 100%;
        max-width: 1200px; /* [핵심] 콘텐츠가 늘어날 수 있는 최대 폭 제한 */
        margin-left: auto; /* [핵심] 좌측 마진 자동 계산으로 정중앙 배치 */
        margin-right: auto; /* [핵심] 우측 마진 자동 계산으로 정중앙 배치 */
        padding: 2.5rem 1.5rem; /* 좌우 패딩을 주어 양옆 화면에 붙지 않도록 방지 */
        box-sizing: border-box; /* 패딩이 전체 너비에 영향을 주지 않도록 고정 */
    }

    .footer-container2 {
        width: 100%;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        padding: 2.5rem 1rem; /* py-10 px-4 */
    }

    @media (min-width: 1280px) {
        .footer-container {
            padding-left: 100px;
            padding-right: 100px; /* xl:px-0 */
        }
    }

    /* 1. 상단 라인 영역 */
    .footer-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--border-base-200, #e5e7eb);
        padding-bottom: 1.5rem; /* pb-6 */
    }

    .terms-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.75rem; /* text-xs */
        font-weight: 500;
    }

    .terms-list a {
        text-decoration: none;
        color: inherit;
    }

    .terms-list a:hover {
        text-decoration: underline;
    }

    .terms-list .privacy-link {
        color: var(--primary, #4b6bfb);
        font-weight: 700;
    }

    @media (min-width: 768px) {
        .terms-list {
            gap: 1.5rem; /* md:gap-6 */
            font-size: 0.875rem; /* md:text-sm */
        }
    }

    /* 패밀리 사이트 이동 버튼 */
    .family-site-btn {
        display: inline-flex;
        align-items: center;
        padding: 0 0.5rem;
        height: 1.5rem; /* btn-xs 표준 높이 */
        font-size: 0.75rem;
        font-weight: 400;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border-base-300, #d1d5db);
        border-radius: 9999px; /* rounded-full */
        background-color: transparent;
        transition: background-color 0.2s;
    }

    .family-site-btn:hover {
        background-color: var(--bg-base-200, #f3f4f6);
    }

    /* 2. 메인 정보 영역 (항상 옆으로 나타나도록 고정) */
    .footer-body {
        display: flex;
        flex-direction: row; /* 무조건 가로로 배치 */
        justify-content: space-between;
        align-items: flex-start;
        gap: 2.5rem; /* 두 섹션 사이의 여백 */
        padding-top: 2rem;
        padding-bottom: 2rem; /* py-8 */
    }

    /* 좌측 CS 고객센터 섹션 */
    .cs-section {
        flex: 0 0 30%; /* 전체 너비의 30% 고정 할당 */
        min-width: 240px; /* 화면이 작아져도 글자가 깨지지 않도록 최소 너비 제한 */
    }

    .cs-section .section-title {
        color: var(--text-base-content, #1f2937);
        font-size: 1rem; /* text-base */
        font-weight: 700;
        margin: 0 0 0.5rem 0; /* mb-2 */
    }

    .cs-section .cs-number {
        color: var(--primary, #4b6bfb);
        font-size: 1.5rem; /* text-2xl */
        font-weight: 900; /* font-black */
        margin: 0;
    }

    .cs-section .cs-hours {
        color: var(--text-base-content-70, #4b5563);
        font-size: 0.75rem; /* text-xs */
        margin-top: 0.5rem;
    }

    .cs-section .cs-hours p {
        margin: 0 0 0.25rem 0;
    }

    /* 우측 사업자 등록 정보 섹션 */
    .company-section {
        flex: 1; /* 남은 공간을 모두 차지하도록 유연하게 설정 */
        color: var(--text-base-content-70, #4b5563);
        font-size: 0.75rem; /* text-xs */
    }

    .company-section p {
        margin: 0 0 0.375rem 0;
    }

    .company-section .company-name {
        color: var(--text-base-content, #1f2937);
        font-weight: 700;
    }

    .company-section .underline-link {
        color: inherit;
        text-decoration: underline;
    }

    .company-section .legal-notice {
        color: var(--text-base-content-50, #9ca3af);
        font-size: 11px; /* text-[11px] */
        padding-top: 0.5rem; /* pt-2 */
        margin-top: 0.5rem;
    }

    /* 3. 하단 카피라이트 */
    .footer-bottom {
        border-top: 1px solid var(--border-base-200, #e5e7eb);
        padding-top: 1.5rem; /* pt-6 */
        text-align: center;
        font-size: 0.75rem; /* text-xs */
        color: var(--text-base-content-50, #9ca3af);
    }

    .footer-bottom p {
        margin: 0;
    }
</style>
