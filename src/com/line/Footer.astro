---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-container">
        <!-- 1. 상단 약관 및 가이드 링크 -->
        <div class="footer-top">
            <ul class="terms-list">
                <li><a href="/terms">이용약관</a></li>
                <li>
                    <a href="/privacy" class="privacy-link">개인정보처리방침</a>
                </li>
                <!-- [통합] 두 사이트의 가이드 링크를 모두 노출합니다 -->
                <li><a href="/guide/shipping">배송/반품안내</a></li>
                <li><a href="/guide/shopping">쇼핑몰 이용안내</a></li>
                <li><a href="/guide/report">실종 제보 수칙</a></li>
                <li><a href="/guide/adopt">입양/분양 가이드</a></li>
            </ul>

            <!-- [삭제] 패밀리 사이트 이동 버튼은 사이트가 통합되었으므로 제거했습니다 -->
        </div>

        <!-- 2. 메인 정보 (고객센터 & 사업자 정보) -->
        <div class="footer-body">
            <!-- CS 통합 고객센터 섹션 -->
            <div class="cs-section">
                <!-- [통합] 고객센터 타이틀을 통합 명칭으로 변경 -->
                <h3 class="section-title">📞 펫줍 통합 고객센터</h3>
                <p class="cs-number">1588-0000</p>
                <div class="cs-hours">
                    <p>운영시간: 평일 09:00 ~ 18:00 (점심시간 12:00 ~ 13:00)</p>
                    <!-- [통합] 쇼핑몰 휴무 정보와 24시간 제보 가능 안내를 병합 -->
                    <p>
                        주말 및 공휴일 휴무 (단, 실종·제보 등록은 24시간 가능)
                    </p>
                    <p>이메일: help@petjup.com</p>
                </div>
            </div>

            <!-- 사업자 등록 정보 섹션 -->
            <div class="company-section">
                <p class="company-name">(주)펫.닷컴 컴퍼니</p>
                <p>
                    대표자: 홍길동 | 사업자등록번호: 000-00-00000
                    <a href="#" class="underline-link">사업자정보확인</a>
                </p>
                <p>
                    통신판매업신고: 2026-서울강남-0000호 | 개인정보보호책임자:
                    김철수
                </p>
                <p>주소: 서울특별시 강남구 테헤란로 123 펫줍타워 5층</p>

                <!-- [통합] 두 서비스의 법적 고지문을 하나의 문단으로 자연스럽게 연결했습니다 -->
                <p class="legal-notice">
                    (주)펫.닷컴은 통신판매중개자로서 통신판매의 당사자가 아니며,
                    입점업체가 등록한 상품, 거래정보 및 거래에 대해 책임을 지지
                    않습니다. 더불어 펫줍 찾아주기·분양 서비스는 유기동물 보호
                    및 무료/합법 분양 정보 매개 플랫폼으로, 허위 제보 및 불법
                    매매 게시물 등록 시 관련 법률에 따라 처벌받을 수 있습니다.
                </p>
            </div>
        </div>

        <!-- 3. 카피라이트 -->
        <div class="footer-bottom">
            <p>© {currentYear} PET Corp. All rights reserved.</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        width: 100%;
        margin-top: auto;
        border-top: 1px solid var(--border-base-200, #e5e7eb);
        background-color: var(--bg-base-100, #ffffff);
        color: var(--text-base-content, #1f2937);
        opacity: 0.8;
        font-size: 0.875rem;
    }

    /* 통합 푸터가 사용하는 단일 컨테이너 */
    .footer-container {
        width: 100%;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        padding: 2.5rem 1.5rem;
        box-sizing: border-box;
    }

    @media (min-width: 1280px) {
        .footer-container {
            padding-left: 100px;
            padding-right: 100px;
        }
    }

    /* 1. 상단 라인 영역 */
    .footer-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--border-base-200, #e5e7eb);
        padding-bottom: 1.5rem;
    }

    .terms-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .terms-list a {
        text-decoration: none;
        color: inherit;
    }

    .terms-list a:hover {
        text-decoration: underline;
    }

    .terms-list .privacy-link {
        color: var(--primary, #4b6bfb);
        font-weight: 700;
    }

    @media (min-width: 768px) {
        .terms-list {
            gap: 1.5rem;
            font-size: 0.875rem;
        }
    }

    /* 2. 메인 정보 영역 */
    .footer-body {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2.5rem;
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    /* 좌측 CS 통합 고객센터 섹션 */
    .cs-section {
        flex: 0 0 30%;
        min-width: 240px;
    }

    .cs-section .section-title {
        color: var(--text-base-content, #1f2937);
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
    }

    .cs-section .cs-number {
        color: var(--primary, #4b6bfb);
        font-size: 1.5rem;
        font-weight: 900;
        margin: 0;
    }

    .cs-section .cs-hours {
        color: var(--text-base-content-70, #4b5563);
        font-size: 0.75rem;
        margin-top: 0.5rem;
    }

    .cs-section .cs-hours p {
        margin: 0 0 0.25rem 0;
    }

    /* 우측 사업자 등록 정보 섹션 */
    .company-section {
        flex: 1;
        color: var(--text-base-content-70, #4b5563);
        font-size: 0.75rem;
    }

    .company-section p {
        margin: 0 0 0.375rem 0;
    }

    .company-section .company-name {
        color: var(--text-base-content, #1f2937);
        font-weight: 700;
    }

    .company-section .underline-link {
        color: inherit;
        text-decoration: underline;
    }

    .company-section .legal-notice {
        color: var(--text-base-content-50, #9ca3af);
        font-size: 11px;
        padding-top: 0.5rem;
        margin-top: 0.5rem;
    }

    /* 3. 하단 카피라이트 */
    .footer-bottom {
        border-top: 1px solid var(--border-base-200, #e5e7eb);
        padding-top: 1.5rem;
        text-align: center;
        font-size: 0.75rem;
        color: var(--text-base-content-50, #9ca3af);
    }

    .footer-bottom p {
        margin: 0;
    }
</style>
