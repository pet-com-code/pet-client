---
import { Image } from "astro:assets";
import ImgLogo from "@/assets/img/petIcon.png";
import ThemeToggle from "@/com/theme/ThemeToggleCSS.astro";

interface Props {
    user?: any; // 진입점으로부터 넘겨받을 유저 데이터 타입 정의
}

const { user = null } = Astro.props;

const isLoggedIn = user !== null;
console.log("[ HOME ]에서 확인한 로그인 상태:", isLoggedIn, "유저 정보:", user);
---

<main>
    <header class="header-container">
        <!-- 로고 영역 -->
        <h1 class="logo-box">
            <!-- div 대신 h1를 쓰는 이유 : SEO(검색엔진 최적화) -->
            <a href="/">
                <Image src={ImgLogo} width={150} alt="펫 아이콘" />
            </a>
        </h1>

        <!-- 3. 🌟 우측 수직 정렬 유틸리티 묶음 박스 -->
        <div class="right-utility-box">
            <!-- [1층] 테마 토글 컴포넌트가 위로 안착 -->
            <ThemeToggle />

            <!-- [2층] 로그인 상태 분기 구역이 아래로 배치 -->
            <div class="action-zone">
                {
                    user ? (
                        <div class="sign-box">
                            <a href="/마이보드" class="auth-link login-tab">
                                마이보드
                            </a>
                            <a href="/로그아웃" class="auth-link signup-tab">
                                로그아웃
                            </a>
                        </div>
                    ) : (
                        <div class="sign-box">
                            <a href="/로그인" class="auth-link login-tab">
                                로그인
                            </a>
                            <a href="/회원가입" class="auth-link signup-tab">
                                회원가입
                            </a>
                        </div>
                    )
                }
            </div>
        </div>
    </header>
</main>

<style>
    .action-zone {
        width: 100%;
        display: block;

        /* 💡 [핵심] Astro의 Scoped CSS 조건부 렌더링 버그를 완전히 깨부수는 글로벌 셀렉터 결합 */
        /* 코드 분기 시 Astro의 스타일 세어나감을 막기 위해 :global 처리 */
        :global(.sign-box) {
            display: flex !important;
            width: 180px !important;
            height: 38px !important;
            background-color: #ffffff !important;
            border: 1px solid var(--theme-main, #333333) !important; /* 테마 메인선 자동 추적 */
            border-radius: 20px !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
        }

        /* 로그인 / 회원가입 내부 글자 링크 버튼 스타일 강제 주입 */
        :global(.auth-link) {
            flex: 1 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            color: var(--text-main, #333333) !important;
            background-color: #ffffff !important;
            transition: all 0.2s ease !important;

            /* 마우스 호버 시 포인트 컬러 및 은은한 배경 피드백 */
            &:hover {
                background-color: var(--theme-bg-light, #f3f4f6) !important;
                color: var(--theme-hover, #111827) !important;
            }
        }
        /* 가운데를 갈라주는 얇은 세로 구분선 */
        /* 반반 쪼개주는 가운데 얇은 세로선 */

        :global(.login-tab) {
            border-right: 1px solid var(--theme-main, #333333) !important;
        }
    }
</style>
