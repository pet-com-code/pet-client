---
import { Image } from "astro:assets";
import ImgLogo from "@/assets/img/petIcon.png";
import ThemeToggle from "@/com/theme/ThemeToggleCSS.astro";

interface Props {
    user?: any; // 진입점으로부터 넘겨받을 유저 데이터 타입 정의
}

const { user = null } = Astro.props;

const isLoggedIn = user !== null;
console.log("[ HOME ]에서 확인한 로그인 상태:", isLoggedIn, "유저 정보:", user);
---

<main>
    <header class="header-container">
        <!-- 로고 영역 -->
        <h1 class="logo-box">
            <!-- div 대신 h1를 쓰는 이유 : SEO(검색엔진 최적화) -->
            <a href="/">
                <Image src={ImgLogo} width={150} alt="펫 아이콘" />
            </a>
        </h1>

        <!-- 3. 🌟 우측 수직 정렬 유틸리티 묶음 박스 -->
        <div class="right-utility-box">
            <!-- [1층] 테마 토글 컴포넌트가 위로 안착 -->
            <ThemeToggle />

            <!-- [2층] 로그인 상태 분기 구역이 아래로 배치 -->
            <div class="action-zone">
                {
                    user ? (
                        <div class="sign-box">
                            <a href="/마이보드" class="auth-link login-tab">
                                마이보드
                            </a>
                            <a href="/로그아웃" class="auth-link signup-tab">
                                로그아웃
                            </a>
                        </div>
                    ) : (
                        <div class="sign-box">
                            <a href="/로그인" class="auth-link login-tab">
                                로그인
                            </a>
                            <a href="/회원가입" class="auth-link signup-tab">
                                회원가입
                            </a>
                        </div>
                    )
                }
            </div>
        </div>
    </header>
</main>

<style>
    .header-container {
        position: relative; /* 우측 유틸리티 고정을 위한 기준축 */
        width: 100%;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px;

        /* 로고 박스 스타일 */
        .logo-box {
            height: 90px;
            display: block;
            img {
                height: auto;
                width: 200px;
            }
        }

        .search-box {
            width: 650px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .action-zone {
            width: 100%;
            display: block;
        }
    }
</style>
