---
// src/components/PhoneSlider.astro
// 필요한 경우 여기에 외부 Props를 정의할 수도 있습니다.
---

<div class="mobile-content-area">
    <div class="phone-mockup">
        <div class="phone-screen">
            <div class="app-header">
                <span>12:30</span>
                <span>🔋</span>
            </div>

            <!-- 슬라이더 컨테이너 -->
            <div class="phone-slider">
                <div class="slider-wrapper">
                    <!-- [슬라이드 1] 서비스 소개 -->
                    <div
                        class="slide active"
                        style="background-color: #f8fafc;"
                    >
                        <span class="slide-emoji">🐶🐱</span>
                        <h4>우리 동네 멍냥이들</h4>
                        <p>
                            귀여운 이웃 반려동물들의<br />일상을 실시간으로
                            구경해요.
                        </p>
                    </div>

                    <!-- [슬라이드 2] 정보 공유 -->
                    <div class="slide" style="background-color: #f0fdf4;">
                        <span class="slide-emoji">💬</span>
                        <h4>집사들의 정보 공유</h4>
                        <p>
                            궁금한 병원 정보부터<br />꿀템까지 함께 나눠보세요.
                        </p>
                    </div>

                    <!-- [슬라이드 3] 마지막 화면 (앱 다운로드) -->
                    <div class="slide">
                        <div class="app-content">
                            <span class="app-icon">📱</span>
                            <h4>멍냥타운 APP</h4>
                            <p>
                                더 빠른 실시간 알림과<br />커뮤니티를 앱으로
                                만나보세요!
                            </p>
                            <div class="download-badge-box">
                                <span class="badge">Google Play</span>
                                <span class="badge">App Store</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ==========================================================================
        우측 모바일 폰 사이드바 및 목업 스타일
       ========================================================================== */
    .mobile-content-area {
        width: 292.5px; /* 부모 높이 585px의 딱 절반 크기 */
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
    }

    .phone-mockup {
        width: 100%;
        height: 100%;
        aspect-ratio: 1 / 2; /* 1:2 비율 고정 */
        background-color: #0f172a;
        border-radius: 40px;
        padding: 12px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        box-sizing: border-box;
    }

    .phone-screen {
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        border-radius: 30px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .app-header {
        height: 28px;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 11px;
        color: #94a3b8;
        font-weight: 600;
        z-index: 10;
    }

    /* ==========================================================================
        폰 내부 슬라이더 & 콘텐츠 스타일
       ========================================================================== */
    .phone-slider {
        flex: 1;
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .slider-wrapper {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.6s ease-in-out,
            visibility 0.6s ease-in-out;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        text-align: center;
        box-sizing: border-box;
    }

    .slide.active {
        opacity: 1;
        visibility: visible;
    }

    .slide-emoji {
        font-size: 56px;
        margin-bottom: 16px;
    }

    .slide h4,
    .app-content h4 {
        margin: 0 0 10px 0;
        font-size: 18px;
        color: #1e293b;
    }

    .slide p {
        margin: 0;
        font-size: 12px;
        color: #64748b;
        line-height: 1.6;
    }

    .app-content {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .app-icon {
        font-size: 56px;
        margin-bottom: 16px;
    }

    .app-content p {
        margin: 0 0 28px 0;
        font-size: 12px;
        color: #64748b;
        line-height: 1.6;
    }

    .download-badge-box {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
    }

    .badge {
        background: #0f172a;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 10px 0;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .badge:hover {
        background: #334155;
    }
</style>

<script>
    // Astro는 클라이언트 측 스크립트를 빌드 시 자동으로 처리합니다.
    function initPhoneSlider() {
        const slides = document.querySelectorAll(".slide");
        if (slides.length === 0) return;

        let currentSlide = 0;
        const slideInterval = 3000;

        function nextSlide() {
            slides[currentSlide].classList.remove("active");
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add("active");
        }

        setInterval(nextSlide, slideInterval);
    }

    // 페이지가 처음 로드되거나 Astro View Transitions 사용 시 모두 작동하도록 수명 주기 처리
    document.addEventListener("DOMContentLoaded", initPhoneSlider);
    document.addEventListener("astro:after-swap", initPhoneSlider);
</script>
