---
import { SITE_CONFIG } from "@/lib/site";
---

<!-- 1. 구조 설계: ID 대신 CLASS 및 Data Attribute 기반으로 변경하여 중복 로딩 문제 해결 -->
<div class="theme-toggle-container" role="radiogroup" aria-label="테마 선택">
    <!-- 강아지 버튼 -->
    <button
        type="button"
        class="toggle-btn toggle-btn-dog"
        role="radio"
        aria-checked="true"
        aria-label="강아지 테마"
    >
        <span class="emoji" aria-hidden="true">🐶</span>
    </button>

    <!-- 고양이 버튼 -->
    <button
        type="button"
        class="toggle-btn toggle-btn-cat"
        role="radio"
        aria-checked="false"
        aria-label="고양이 테마"
    >
        <span class="emoji" aria-hidden="true">🐱</span>
    </button>
</div>

<!-- 💡 ⭐ is:inline 속성을 반드시 추가해야 define:vars 값이 정상 전달되고 전역 스크립트로 동작합니다. -->
<script
    is:inline
    define:vars={{
        COOKIE_KEY: SITE_CONFIG.theme.cookieKey,
        STORAGE_KEY: SITE_CONFIG.theme.storageKey,
        DEFAULT_THEME: SITE_CONFIG.theme.defaultTheme
    }}
>
    function setupThemeToggle() {
        // querySelectorAll을 사용하여 페이지 내 모든 테마 토글 버튼을 함께 제어 (헤더 + 본문 중복 대응)
        const dogBtns = document.querySelectorAll(".toggle-btn-dog");
        const catBtns = document.querySelectorAll(".toggle-btn-cat");

        if (dogBtns.length === 0 && catBtns.length === 0) return;

        // 1. 현재 적용된 테마 감지 (쿠키 -> 로컬스토리지 -> DOM 속성 -> 기본값)
        const getActiveTheme = () => {
            const match = document.cookie.match(
                new RegExp(`(?:^|; )${COOKIE_KEY}=([^;]*)`)
            );
            if (match) return match[1];
            return (
                localStorage.getItem(STORAGE_KEY) ||
                document.documentElement.getAttribute("data-theme") ||
                DEFAULT_THEME
            );
        };

        // 2. 버튼 활성화 상태 UI updates (.active 클래스 및 ARIA)
        const updateToggleStyle = (theme) => {
            const toggleClasses = (activeBtns, inactiveBtns) => {
                activeBtns.forEach((btn) => {
                    btn.classList.add("active");
                    btn.setAttribute("aria-checked", "true");
                });
                inactiveBtns.forEach((btn) => {
                    btn.classList.remove("active");
                    btn.setAttribute("aria-checked", "false");
                });
            };

            if (theme === "cat") {
                toggleClasses(catBtns, dogBtns);
            } else {
                toggleClasses(dogBtns, catBtns);
            }
        };

        // 3. 테마 변경 및 저장
        const applyTheme = (targetTheme) => {
            document.documentElement.setAttribute("data-theme", targetTheme);

            // 로컬스토리지 & 쿠키 저장
            localStorage.setItem(STORAGE_KEY, targetTheme);
            document.cookie = `${COOKIE_KEY}=${targetTheme}; path=/; max-age=31536000; SameSite=Lax`;

            updateToggleStyle(targetTheme);
        };

        // 4. 이벤트 바인딩 (모든 버튼에 적용)
        dogBtns.forEach((btn) => {
            btn.onclick = (e) => {
                e.stopPropagation();
                applyTheme("dog");
            };
        });

        catBtns.forEach((btn) => {
            btn.onclick = (e) => {
                e.stopPropagation();
                applyTheme("cat");
            };
        });

        // 초기 실행
        updateToggleStyle(getActiveTheme());
    }

    // Astro 생명주기 대응 스크립트 실행 등록
    document.addEventListener("DOMContentLoaded", setupThemeToggle);
    document.addEventListener("astro:after-swap", setupThemeToggle);
    document.addEventListener("astro:page-load", setupThemeToggle);
</script>

<style>
    /* 컨테이너 글래스모피즘 구현 */
    .theme-toggle-container {
        position: relative;
        z-index: 10;
        display: flex;
        width: fit-content;
        gap: 0.375rem;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 0.25rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(12px);

        /* theme.css의 연한 회색/테마 배경과 자연스럽게 매칭 */
        background-color: var(--color-base-200);
        transition: background-color 0.3s ease;
    }

    /* 버튼 기본 스타일링 및 애니메이션 */
    .toggle-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.375rem;
        height: 2.375rem;
        cursor: pointer;
        border-radius: 9999px;
        border: none;
        background-color: transparent;
        padding: 0;
        transition: all 250ms ease-in-out;
    }

    .toggle-btn:active {
        /* theme.css의 브랜드 대표 포인트 컬러 적용 */
        background-color: var(--color-primary);
        box-shadow: var(--custom-shadow);
        transform: scale(1.05);
    }

    /* 이모지 기본 불투명도 및 흑백 필터 */
    .emoji {
        display: inline-block;
        transform: translateZ(0);
        font-size: 1.125rem;
        opacity: 0.5;
        filter: grayscale(40%);
        transition:
            filter 250ms,
            opacity 250ms;
    }

    /* ⭐ 자바스크립트가 제어할 활성화(.active) 상태 스타일 명세 */
    .toggle-btn.active {
        background-color: var(--theme-bg); /* bg-theme-bg */
        box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.1),
            0 2px 4px -1px rgba(0, 0, 0, 0.06); /* shadow-md */
        transform: scale(105%); /* scale-105 */
    }

    .toggle-btn.active .emoji {
        opacity: 1; /* opacity-50 해제 */
        filter: grayscale(0%); /* grayscale-40 해제 */
    }

    /* 모바일 타겟 미디어 쿼리 (Tailwind의 md: 스펙 대응) */
    @media (min-width: 768px) {
        .theme-toggle-container {
            gap: 0.375rem;
            padding: 0.25rem;
        }
        .toggle-btn {
            width: 2.25rem; /* md:h-9, md:w-9 */
            height: 2.25rem;
        }
        .emoji {
            font-size: 1.125rem; /* md:text-lg */
        }
    }
</style>
