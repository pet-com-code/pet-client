<style>
    /* 사라지는 상태가 되면 bounce 애니메이션을 끄고 transform을 적용합니다 */
    :global(#audio-guide-bubble.guide-bubble-fade-out),
    :global(.guide-bubble-fade-out) {
        animation: none !important; /* 👈 핵심: Tailwind의 animate-bounce를 강제로 비활성화 */
        opacity: 0 !important;
        transform: translate(-50%, -80%) scale(0.7) !important; /* 원하시는 위치/크기 */
    }
</style>
