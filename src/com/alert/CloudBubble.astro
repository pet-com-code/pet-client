---
interface Props {
    id?: string;
    icon?: string;
    message?: string;
}

const {
    id = "audio-guide-bubble",
    icon = "📸",
    message = "화면을 클릭하면<br />셔터 소리와 함께 시작됩니다!"
} = Astro.props;
---

<!-- 1. 바깥 레이어: 고정 위치 잡기 (-50%, -50% 중앙 정렬) -->
<div
    id={id}
    class="pointer-events-none fixed top-1/2 left-1/2 z-100000 -translate-x-1/2 -translate-y-1/2 transition-all duration-300"
>
    <!-- 2. 안쪽 레이어: 둥둥 떠있는 애니메이션(animate-bounce) 및 구름 모양 -->
    <div
        class="cloud-bubble bg-theme-main relative flex animate-bounce flex-col items-center justify-center rounded-[40px] border border-white/80 px-6 py-4 text-slate-800 shadow-2xl"
    >
        <!-- 아이콘 & 메시지 -->
        <span class="mb-1 block text-2xl drop-shadow-sm filter">{icon}</span>
        <p
            class="m-0 text-center text-sm leading-relaxed font-bold whitespace-nowrap"
            set:html={message}
        />

        <!-- 구름 아래 몽글몽글 꼬리 방울 2개 -->
        <div
            class="bg-theme-main absolute -bottom-2 left-1/2 h-4 w-4 -translate-x-1/2 rounded-full shadow-md"
        >
        </div>
        <div
            class="bg-theme-main absolute -bottom-4 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full shadow-sm"
        >
        </div>
    </div>
</div>

