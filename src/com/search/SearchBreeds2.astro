---
// 1. Props 정의 및 기본값 설정
interface Props {
    searchWidth?: string;
    searchHeight?: string;
}

const { searchWidth = "800px", searchHeight = "46px" } = Astro.props;
---

<div class="search-container" id="custom-search-container">
    <input
        type="text"
        id="search-input"
        placeholder="댕댕이, 냥이 품종을 검색해보세요! (리트, 아프간, 아메리칸) 🐾"
        autocomplete="off"
    />

    <button
        type="button"
        id="custom-search-btn"
        class="search-btn"
        aria-label="검색"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
    </button>

    <!-- 자동완성 결과 리스트 -->
    <ul id="results-list" class="search-results"></ul>
</div>

<style>
    .search-container {
        width: 100%;
        position: relative;
        display: block;
        z-index: 10; /* 테마 전환 버튼 등 외부 UI 클릭 방해를 막기 위해 적절한 레이어 레벨 유지 */
    }

    .search-container input {
        width: 100%;
        height: 50px;
        padding: 0 60px 0 2rem;
        font-size: 1.4rem;
        border: 2px solid var(--theme-main, #4a90e2);
        border-radius: 45px;
        box-sizing: border-box;
        outline: none;
        background-color: #f1f3f5;
        transition: 0.2s;
        color: #212529 !important;
    }

    .search-container input:focus {
        background-color: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .search-btn {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        background: transparent !important;
        border: none;
        color: var(--theme-main, #4a90e2) !important;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
            transform 0.2s ease-in-out,
            color 0.2s;
        border-radius: 50%;
    }

    .search-btn svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .search-btn:hover {
        background: rgba(0, 0, 0, 0.05) !important;
        transform: translateY(-50%) scale(1.15);
    }

    .search-results {
        list-style: none;
        padding: 0;
        margin: 0;
        border: 1px solid #ddd;
        border-radius: 12px;
        background: white !important;
        max-height: 400px;
        overflow-y: auto;
        display: none;
        position: absolute;
        left: 0;
        width: 100%;
        z-index: 20; /* 검색 드롭다운만 검색바 위에 노출 */
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        color: #212529 !important;
    }

    /* 동적 생성 item 스타일 (global) */
    :global(.selectable-item) {
        padding: 14px 24px !important;
        cursor: pointer;
        border-bottom: 1px solid #f1f3f5;
        font-size: 15.5px !important;
        transition: all 0.2s ease;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        color: #212529 !important;
        background-color: #ffffff !important;
    }

    :global(.selectable-item strong) {
        color: #111111 !important;
        font-weight: 700 !important;
    }

    :global(.selectable-item.selected),
    :global(.selectable-item:hover) {
        background-color: #f8f9fa !important;
        box-shadow: inset 5px 0 0 0 var(--theme-main, #4a90e2);
        padding-left: 28px !important;
    }

    :global(.breed-info) {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
    }

    /* 강아지 / 고양이 구분 뱃지 */
    :global(.badge) {
        font-size: 11px !important;
        padding: 3px 8px !important;
        border-radius: 12px !important;
        color: white !important;
        font-weight: bold !important;
        display: inline-block !important;
        flex-shrink: 0;
    }
    :global(.badge.dog) {
        background-color: #4a90e2 !important;
    }
    :global(.badge.cat) {
        background-color: #f2acc6 !important;
    }

    /* 실종 / 발견 / 보호 제보 뱃지 영역 */
    :global(.status-badges) {
        display: inline-flex !important;
        gap: 6px !important;
        align-items: center !important;
    }
    :global(.report-badge) {
        font-size: 11px !important;
        padding: 3px 8px !important;
        border-radius: 10px !important;
        font-weight: bold !important;
        display: inline-block !important;
    }
    :global(.report-badge.missing) {
        background-color: #ffe6e6 !important;
        color: #e53e3e !important;
    }
    :global(.report-badge.sighted) {
        background-color: #fffbe6 !important;
        color: #d69e2e !important;
    }
    :global(.report-badge.protected) {
        background-color: #e6fffa !important;
        color: #319795 !important;
    }
    :global(.no-report) {
        color: #aaaaaa !important;
        font-size: 12px !important;
    }
</style>

<script define:vars={{ searchWidth, searchHeight }}>
    // Astro ViewTransitions / HMR 재실행 대비 및 이벤트 중복 등록 방지 로직
    const initSearchComponent = () => {
        const container = document.getElementById("custom-search-container");
        const searchInput = document.getElementById("search-input");
        const searchBtn = document.getElementById("custom-search-btn");
        const resultsList = document.getElementById("results-list");

        if (!container || !searchInput || !resultsList) return;

        let currentIndex = -1;
        let debounceTimer = null;

        container.style.width = "100%";
        resultsList.style.top = `calc(${searchHeight} + 8px)`;

        // 1. 항목 선택 시 처리 (원하는 검색 이동 경로로 변경 가능)
        const selectItem = (breed) => {
            const breedName = breed.name || breed.nameKo || "";
            const breedId = breed.id || "";

            searchInput.value = breedName;
            resultsList.style.display = "none";
            currentIndex = -1;

            // 선택한 품종 기반으로 검색 결과 페이지 이동
            window.location.href = `/search?q=${encodeURIComponent(breedName)}&breedId=${encodeURIComponent(breedId)}`;
        };

        // 2. 키보드 선택 하이라이트
        const highlightItem = (items) => {
            Array.from(items).forEach((item) =>
                item.classList.remove("selected")
            );
            if (currentIndex >= 0 && items[currentIndex]) {
                items[currentIndex].classList.add("selected");
                items[currentIndex].scrollIntoView({ block: "nearest" });
            }
        };

        // 3. API 호출 및 DOM 렌더링
        const fetchAndRenderResults = async (keyword) => {
            try {
                /*
                    환경별 API 서버 주소 자동 분기
                    */
                const baseUrl = window.location.hostname.includes("localhost")
                    ? "http://localhost:8787"
                    : "https://petjup.com";

                const response = await fetch(
                    `${baseUrl}/search/breeds?q=${encodeURIComponent(keyword)}`
                );

                // const response = await fetch(
                //     `https://petjup.com/api/search/breeds-all?q=${encodeURIComponent(keyword)}`
                // );
                if (!response.ok) throw new Error("API Network error");

                const results = await response.json();
                console.log("results :: ", results);

                resultsList.innerHTML = "";
                currentIndex = -1;

                if (!results || results.length === 0) {
                    resultsList.innerHTML = `<li style="padding: 14px 24px; color:#888;">검색 결과가 없습니다 🐾</li>`;
                    resultsList.style.display = "block";
                    return;
                }

                results.forEach((breed) => {
                    const li = document.createElement("li");
                    li.classList.add("selectable-item");

                    const breedName =
                        breed.name || breed.nameKo || "품종명 없음";
                    const petType =
                        breed.petType ||
                        (breed.id && breed.id.startsWith("cat_")
                            ? "CAT"
                            : "DOG");
                    const isDog = petType === "DOG";
                    const badgeClass = isDog ? "dog" : "cat";
                    const badgeText = isDog ? "강아지" : "고양이";

                    const missingCount = Number(
                        breed.missingCount || breed.missing_count || 0
                    );
                    const sightedCount = Number(
                        breed.sightedCount || breed.sighted_count || 0
                    );
                    const protectedCount = Number(
                        breed.protectedCount || breed.protected_count || 0
                    );
                    const totalReport = Number(
                        breed.reportCount ||
                            breed.report_count ||
                            missingCount + sightedCount + protectedCount
                    );

                    let statusBadgesHtml = '<div class="status-badges">';
                    if (missingCount > 0)
                        statusBadgesHtml += `<span class="report-badge missing">실종 ${missingCount}</span>`;
                    if (sightedCount > 0)
                        statusBadgesHtml += `<span class="report-badge sighted">발견 ${sightedCount}</span>`;
                    if (protectedCount > 0)
                        statusBadgesHtml += `<span class="report-badge protected">보호 ${protectedCount}</span>`;
                    if (totalReport === 0)
                        statusBadgesHtml += `<span class="no-report">제보 없음</span>`;
                    statusBadgesHtml += "</div>";

                    // 💡 [강아지/고양이] 뱃지 -> 품종명 순서 배치
                    li.innerHTML = `
                        <div class="breed-info">
                            <span class="badge ${badgeClass}">${badgeText}</span>
                            <strong>${breedName}</strong>
                        </div>
                        ${statusBadgesHtml}
                    `;

                    li.addEventListener("click", () => selectItem(breed));
                    resultsList.appendChild(li);
                });

                resultsList.style.display = "block";
            } catch (error) {
                console.error("❌ 품종 검색 에러:", error);
                resultsList.innerHTML = `<li style="padding: 14px 24px; color:red;">데이터를 불러오는 중 오류가 발생했습니다.</li>`;
                resultsList.style.display = "block";
            }
        };

        // 4. 입력 디바운싱
        const handleInput = (e) => {
            const keyword = e.target.value.trim();
            if (debounceTimer) clearTimeout(debounceTimer);

            if (keyword === "") {
                resultsList.innerHTML = "";
                resultsList.style.display = "none";
                currentIndex = -1;
                return;
            }

            debounceTimer = setTimeout(() => {
                fetchAndRenderResults(keyword);
            }, 300);
        };

        // 5. 키보드 이동 및 엔터 이벤트
        const handleKeyDown = (e) => {
            const items = resultsList.querySelectorAll(".selectable-item");

            if (resultsList.style.display !== "none" && items.length > 0) {
                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    currentIndex = (currentIndex + 1) % items.length;
                    highlightItem(items);
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    currentIndex =
                        (currentIndex - 1 + items.length) % items.length;
                    highlightItem(items);
                } else if (e.key === "Enter") {
                    e.preventDefault();
                    if (currentIndex >= 0 && items[currentIndex]) {
                        items[currentIndex].click();
                    } else {
                        const keyword = searchInput.value.trim();
                        if (keyword)
                            window.location.href = `/search?q=${encodeURIComponent(keyword)}`;
                    }
                } else if (e.key === "Escape") {
                    resultsList.style.display = "none";
                }
            }
        };

        // 이벤트 바인딩
        searchInput.addEventListener("input", handleInput);
        searchInput.addEventListener("keydown", handleKeyDown);

        searchBtn?.addEventListener("click", () => {
            const keyword = searchInput.value.trim();
            if (keyword) {
                window.location.href = `/search?q=${encodeURIComponent(keyword)}`;
            } else {
                alert("검색어를 입력해 주세요! 🐾");
                searchInput.focus();
            }
        });

        // 💡 외부 영역 클릭 시 드롭다운만 안전하게 닫기 (테마 전환 버튼 등 다른 UI 클릭 방해 금지)
        const handleOutsideClick = (e) => {
            const path = e.composedPath ? e.composedPath() : [];
            if (!path.includes(container) && resultsList) {
                resultsList.style.display = "none";
            }
        };

        document.addEventListener("click", handleOutsideClick);
    };

    // Astro DOM 로드 및 페이지 전환시 안전하게 초기화
    document.addEventListener("DOMContentLoaded", initSearchComponent);
    document.addEventListener("astro:page-load", initSearchComponent);
</script>
