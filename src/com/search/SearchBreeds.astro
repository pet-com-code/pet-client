---
// SearchBar.astro
interface Props {
    searchWidth?: string;
    searchHeight?: string;
}

const { searchWidth = "800px", searchHeight = "46px" } = Astro.props;
---

<div
    class="search-container"
    style={`--width: ${searchWidth}; --height: ${searchHeight};`}
>
    <div class="search-box">
        <input
            type="text"
            id="search-input"
            placeholder="품종 또는 지역을 검색하세요 (예: 리트리버, 강남구)"
            autocomplete="off"
        />
        <button type="button" id="search-btn" aria-label="검색">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>
    </div>

    <ul id="results-list" class="results-dropdown hidden" role="listbox"></ul>
</div>

<style lang="scss">
    /* CSS 변수 선언 */
    .search-container {
        --primary-color: #2b82fb;
        --primary-hover: #1b6cd8;
        --border-color: #e2e8f0;
        --bg-light: #ffffff;
        --bg-hover: #f8fafc;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --shadow:
            0 10px 25px -5px rgba(0, 0, 0, 0.1),
            0 8px 10px -6px rgba(0, 0, 0, 0.1);

        position: relative;
        width: 100%;
        max-width: var(--width);
        margin: 0 auto;
        z-index: 10;
    }

    .search-box {
        display: flex;
        align-items: center;
        width: 100%;
        height: var(--height);
        background-color: var(--bg-light);
        border: 2px solid var(--border-color);
        border-radius: 9999px;
        padding: 0 0.5rem 0 1.25rem;
        transition: all 0.2s ease;

        &:focus-within {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(43, 130, 251, 0.15);
        }

        input {
            flex: 1;
            height: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.95rem;
            color: var(--text-main);

            &::placeholder {
                color: var(--text-muted);
            }
        }

        button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: calc(var(--height) - 0.5rem);
            height: calc(var(--height) - 0.5rem);
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            transition: background-color 0.2s ease;

            &:hover {
                background-color: var(--primary-hover);
            }
        }
    }

    /* Dropdown Results */
    .results-dropdown {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        right: 0;
        background-color: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        box-shadow: var(--shadow);
        max-height: 360px;
        overflow-y: auto;
        padding: 0.5rem 0;
        margin: 0;
        list-style: none;
        z-index: 20;

        &.hidden {
            display: none;
        }
    }

    /* 글로벌 스타일 (JS 동적 태그 대응) */
    :global(.selectable-item) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        transition: background-color 0.15s ease;

        &:hover,
        &.selected {
            background-color: #f8fafc;
        }

        &.unknown-breed-item {
            background-color: #f1f5f9;
            border-bottom: 1px solid #e2e8f0;

            &:hover,
            &.selected {
                background-color: #e2e8f0;
            }
        }
    }

    :global(.item-left) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    :global(.item-name) {
        font-weight: 500;
        color: #0f172a;
    }

    :global(.badge) {
        font-size: 0.75rem;
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
        font-weight: 600;
    }

    :global(.badge-dog) {
        background-color: #dbeafe;
        color: #1e40af;
    }
    :global(.badge-cat) {
        background-color: #fce7f3;
        color: #9d174d;
    }
    :global(.badge-unknown) {
        background-color: #e2e8f0;
        color: #475569;
    }

    :global(.item-reports) {
        display: flex;
        gap: 0.35rem;
    }

    :global(.report-badge) {
        font-size: 0.75rem;
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
        font-weight: 500;
    }

    :global(.report-missing) {
        background-color: #fee2e2;
        color: #991b1b;
    }
    :global(.report-spotted) {
        background-color: #fef3c7;
        color: #92400e;
    }
    :global(.report-shelter) {
        background-color: #dcfce7;
        color: #166534;
    }
    :global(.report-none) {
        background-color: #f1f5f9;
        color: #64748b;
    }

    :global(.no-result) {
        padding: 1rem;
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
    }
</style>

<script>
    function initSearchComponent() {
        const input = document.getElementById(
            "search-input"
        ) as HTMLInputElement;
        const btn = document.getElementById("search-btn");
        const list = document.getElementById("results-list");

        if (!input || !list) return;

        let selectedIndex = -1;
        let debounceTimer: ReturnType<typeof setTimeout>;

        const BASE_URL =
            window.location.hostname === "localhost" ||
            window.location.hostname === "127.0.0.1"
                ? "http://127.0.0.1:8787"
                : "https://petjup.com";

        const hideDropdown = () => {
            list.classList.add("hidden");
            list.innerHTML = "";
            selectedIndex = -1;
        };

        const updateSelection = (items: NodeListOf<Element>) => {
            items.forEach((item, index) => {
                if (index === selectedIndex) {
                    item.classList.add("selected");
                    item.scrollIntoView({ block: "nearest" });
                } else {
                    item.classList.remove("selected");
                }
            });
        };

        const fetchResults = async (query: string) => {
            try {
                const response = await fetch(
                    `${BASE_URL}/search/breeds?q=${encodeURIComponent(query)}`
                );
                if (!response.ok)
                    throw new Error("Network response was not ok");

                const data = (await response.json()) as any[];
                renderResults(data);
            } catch (error) {
                console.error("Search fetch error:", error);
                hideDropdown();
            }
        };

        const renderResults = (items: any[]) => {
            list.innerHTML = "";

            if (!items || items.length === 0) {
                list.innerHTML = `<li class="no-result">검색 결과가 없습니다.</li>`;
                list.classList.remove("hidden");
                return;
            }

            items.forEach((item) => {
                const li = document.createElement("li");
                li.className = `selectable-item ${item.isUnknown ? "unknown-breed-item" : ""}`;
                li.setAttribute("role", "option");

                // 아이콘/뱃지 설정
                let typeBadgeHtml = "";
                if (item.isUnknown) {
                    typeBadgeHtml = `<span class="badge badge-unknown">미상</span>`;
                } else if (
                    item.petType === "CAT" ||
                    item.id?.startsWith("cat_")
                ) {
                    typeBadgeHtml = `<span class="badge badge-cat">고양이</span>`;
                } else {
                    typeBadgeHtml = `<span class="badge badge-dog">강아지</span>`;
                }

                const missingCount = item.missingCount || 0;
                const sightedCount = item.sightedCount || 0;
                const protectedCount = item.protectedCount || 0;

                let reportsHtml = "";
                const hasReports =
                    missingCount > 0 || sightedCount > 0 || protectedCount > 0;

                if (hasReports) {
                    if (missingCount > 0)
                        reportsHtml += `<span class="report-badge report-missing">실종 ${missingCount}</span>`;
                    if (sightedCount > 0)
                        reportsHtml += `<span class="report-badge report-spotted">발견 ${sightedCount}</span>`;
                    if (protectedCount > 0)
                        reportsHtml += `<span class="report-badge report-shelter">보호 ${protectedCount}</span>`;
                } else {
                    reportsHtml = `<span class="report-badge report-none">제보 없음</span>`;
                }

                li.innerHTML = `
          <div class="item-left">
            ${typeBadgeHtml}
            <span class="item-name">${item.name}</span>
          </div>
          <div class="item-reports">
            ${reportsHtml}
          </div>
        `;

                // 💡 [수정] 클릭 시 전체 상세 정보(ID, Breed, PetType, Query 등)를 파라미터로 전송
                // 기본 품종 검색 시: breedId만 넘깁니다. (단, 품종 미상인 경우 breedId=unknown)
                // 지역/장소 검색 시: 드롭다운에서 클릭한 항목의 breedId와 함께 검색창에 입력한 지역명(q)을 함께 전달합니다.
                li.addEventListener("click", () => {
                    const params = new URLSearchParams();
                    const currentQuery = input.value.trim();

                    if (item.isUnknown) {
                        params.set("breedId", "unknown");
                    } else {
                        params.set("breedId", item.id);
                    }

                    if (currentQuery) {
                        params.set("q", currentQuery);
                    }

                    window.location.href = `/search?${params.toString()}`;
                });

                list.appendChild(li);
            });

            list.classList.remove("hidden");
            selectedIndex = -1;
        };

        input.addEventListener("input", (e) => {
            const query = (e.target as HTMLInputElement).value.trim();
            clearTimeout(debounceTimer);

            if (query.length === 0) {
                hideDropdown();
                return;
            }

            debounceTimer = setTimeout(() => {
                fetchResults(query);
            }, 300);
        });

        input.addEventListener("keydown", (e) => {
            const items = list.querySelectorAll(".selectable-item");
            if (list.classList.contains("hidden") || items.length === 0) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();
                selectedIndex = (selectedIndex + 1) % items.length;
                updateSelection(items);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                selectedIndex =
                    (selectedIndex - 1 + items.length) % items.length;
                updateSelection(items);
            } else if (e.key === "Enter") {
                e.preventDefault();
                if (selectedIndex >= 0 && items[selectedIndex]) {
                    (items[selectedIndex] as HTMLElement).click();
                } else if (input.value.trim()) {
                    window.location.href = `/search?q=${encodeURIComponent(input.value.trim())}`;
                }
            } else if (e.key === "Escape") {
                hideDropdown();
            }
        });

        btn?.addEventListener("click", () => {
            if (input.value.trim()) {
                window.location.href = `/search?q=${encodeURIComponent(input.value.trim())}`;
            }
        });

        document.addEventListener("click", (e) => {
            const path = e.composedPath();
            if (!path.includes(input) && !path.includes(list)) {
                hideDropdown();
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initSearchComponent);
    document.addEventListener("astro:page-load", initSearchComponent);
</script>
