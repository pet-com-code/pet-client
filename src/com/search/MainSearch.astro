---
import petJson from "@/assets/json/pets.json";
import eventJson from "@/assets/json/events.json";

// 1. 부모(페이지)로부터 넘겨받을 변수들의 타입을 정의합니다.
interface Props {
    searchWidth?: string;
    searchHeight?: string;
}

// 2. 전달된 데이터가 없을 경우를 대비한 기본값(Fallback)을 설정합니다.
const { searchWidth = "800px", searchHeight = "46px" } = Astro.props;

// 3. 자바스크립트 영역으로 데이터를 전달하기 위해 JSON으로 가공합니다.
const jsonData = JSON.stringify({ petJson, eventJson });
---

<div class="search-container" id="custom-search-container">
    <input
        type="text"
        id="search-input"
        placeholder="데이터를 불러오는 중입니다..."
        disabled
    />

    <button type="button" id="custom-search-btn" class="search-btn">
        <svg
            xmlns="http://w3.org"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
    </button>

    <!-- 자동완성 결과 리스트 -->
    <ul id="results-list" class="search-results"></ul>
</div>

<style>
    /* 1. 전체 컨테이너: 부모 너비(100%)를 꽉 채우고 절대 정렬 기준점을 잡음 */
    .search-container {
        width: 100%;
        position: relative;
        display: block; /* 명시적으로 블록 요소 선언 */
    }

    /* 2. 입력창: 오른쪽 버튼 공간(60px)만큼 여백을 두어 글자가 버튼과 겹치지 않음 */
    .search-container input {
        width: 100%;
        height: 50px; /* 👈 높이를 2배 수준인 90px로 지정 */
        padding: 0 60px 0 2rem; /* 👈 늘어난 높이에 맞춰 좌우 여백 확대 */
        font-size: 1.4rem; /* 👈 큰 검색창에 어울리도록 글자 크기 업그레이드 */
        border: 2px solid var(--theme-main);
        border-radius: 45px; /* 👈 높이의 정확히 절반(90 / 2)으로 수정하여 완벽한 알약 모양 유지 */
        box-sizing: border-box;
        outline: none;
        background-color: #f1f3f5;
        transition: 0.2s;
    }
    .search-container input:focus {
        background-color: #fff;
        box-shadow: 0 2px 8px var(--theme-bg); /* 테마별 그림자 */
    }

    /* 3. 검색 버튼: absolute로 띄우고 내부 아이콘(SVG)을 정확히 정렬 */
    .search-btn {
        position: absolute;
        right: 20px; /* 👈 여백을 조금 더 넓혀 정렬 조정 */
        top: 50%;
        transform: translateY(-50%);
        width: 28px; /* 👈 큰 검색창에 맞춰 버튼 크기 확대 */
        height: 28px; /* 👈 큰 검색창에 맞춰 버튼 크기 확대 */
        background: transparent !important;
        border: none;
        color: var(--theme-main) !important;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
            transform 0.2s ease-in-out,
            color 0.2s;
        border-radius: 50%; /* 마우스 올렸을 때 동그란 배경이 예쁘게 나오도록 설정 */
    }

    /* 버튼 내부의 SVG 아이콘이 있다면 크기를 부모에 맞춤 */
    .search-btn svg {
        width: 18px; /* 👈 기존 20px -> 28px로 확대 */
        height: 18px;
        display: block;
    }

    /* 4. 마우스 호버 상태 */
    .search-btn:hover {
        /* [선택] 만약 은은한 원형 배경색을 넣고 싶다면 아래 주석을 해제하세요 */
        background: rgba(0, 0, 0, 0.05) !important;

        color: var(--theme-hover); /* 글자/아이콘 색상 변경 */
        transform: translateY(-50%) scale(1.15); /* 크기 15% 확대 */
    }

    /* 5. 검색 결과 및 리스트 스타일 (기존 코드 유지) */

    .search-results {
        list-style: none;
        padding: 0;
        margin: 0;
        border: 1px solid #ddd;
        border-radius: 12px;
        background: white;
        max-height: 400px;
        overflow-y: auto;
        display: none;
        position: absolute;
        left: 0;
        width: 100%;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }
    /* .selectable-item {
        padding: 12px 20px;
        cursor: pointer;
        border-bottom: 1px solid #f1f3f5;
    } */

    /* 1. 검색 결과 리스트 아이템 기본 상태 수정 */
    :global(.selectable-item) {
        padding: 14px 24px; /* 👈 위아래 14px, 좌우 여백을 24px로 넓혀 왼쪽 공간을 확보합니다 (기존 20px) */
        cursor: pointer; /* 👈 마우스를 올렸을 때 손가락 포인터로 변경 */
        border-bottom: 1px solid #f1f3f5;
        font-size: 15.5px; /* 👈 기본 폰트 크기를 시원하게 키워 가독성을 높입니다 */
        transition: all 0.2s ease;
    }

    .selectable-item.selected,
    .selectable-item:hover {
        background-color: var(--theme-bg) !important;
        box-shadow: inset 5px 0 0 0 var(--theme-main);
        padding-left: 25px;
        font-weight: 800;
    }

    /* :global()을 붙여서 동적 생성된 뱃지에도 스타일이 먹히도록 합니다 */
    :global(.badge) {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 12px;
        float: right;
        color: white;
        font-weight: bold;
        margin-top: 2px; /* 👈 글자 크기가 커진 만큼 뱃지의 세로 정렬을 살짝 내림 */
    }
    :global(.badge.dog) {
        background-color: #4a90e2 !important;
    }
    :global(.badge.cat) {
        background-color: #f2acc6 !important;
    }
</style>

<!-- 💡 Astro 방식의 데이터 브릿지 구조 적용 -->
<script id="search-data-bridge" type="application/json" set:html={jsonData} />

<!-- 💡 부모에게 전달받은 스타일 변수를 클라이언트 스크립트에 동적으로 바인딩합니다 -->
<script define:vars={{ searchWidth, searchHeight }}>
    const configWidth = searchWidth;
    const configHeight = searchHeight;

    const container = document.getElementById("custom-search-container");
    const searchInput = document.getElementById("search-input");
    const searchBtn = document.getElementById("custom-search-btn");
    const resultsList = document.getElementById("results-list");

    // 1. 동적 스타일 크기 배정 기틀
    if (container && searchInput && searchBtn && resultsList) {
        container.style.width = "100%"; // ◀ 너비를 부모 영역의 100%로 변경
        container.style.maxWidth = "100%"; // ◀ 최대 너비 제한 해제
        container.style.margin = "0 auto";

        // 결과창 리스트의 top 위치만 동적으로 계산하도록 남겨둡니다.
        resultsList.style.top = `calc(${configHeight} + 8px)`;
    }

    // 2. 오리지널 검색 버튼 클릭 이벤트 바인딩
    searchBtn?.addEventListener("click", () => {
        if (!searchInput) return;
        const currentInputValue = searchInput.value.trim();

        if (currentInputValue !== "") {
            selectItem(currentInputValue);
        } else {
            alert("검색어를 입력해 주세요! 🐾");
            searchInput.focus();
        }
    });

    // 3. 데이터 브릿지 추출 로직
    let petsData = [];
    let eventsData = [];
    try {
        const bridgeElement = document.getElementById("search-data-bridge");
        if (bridgeElement) {
            const bridgeData = JSON.parse(bridgeElement.textContent || "{}");
            petsData = bridgeData.pets || [];
            eventsData = bridgeData.events || [];
        }
    } catch (e) {
        console.error("❌ 데이터 브릿지 JSON 파싱 에러:", e);
    }

    // 4. 필터링 유틸리티 함수들
    const filterPets = (keyword) => {
        if (!keyword) return [];
        const lowKey = keyword.toLowerCase();
        return petsData.filter((pet) => {
            const nameKo = pet.nameKo ? pet.nameKo.toLowerCase() : "";
            const nameEn = pet.nameEn ? pet.nameEn.toLowerCase() : "";
            return nameKo.includes(lowKey) || nameEn.includes(lowKey);
        });
    };

    const filterEventsByKeyword = (keyword) => {
        if (!keyword) return [];
        const lowKey = keyword.toLowerCase();
        return eventsData.filter(
            (event) => event.title && event.title.toLowerCase().includes(lowKey)
        );
    };

    const filterEventsByType = (detectedTypes) => {
        if (!detectedTypes || detectedTypes.length === 0) return [];
        return eventsData.filter((event) => {
            if (!event.target) return false;
            if (Array.isArray(event.target)) {
                return event.target.some((t) => detectedTypes.includes(t));
            }
            return detectedTypes.includes(event.target);
        });
    };

    let currentIndex = -1;

    // 5. 키보드 하이라이트 및 선택 로직
    const highlightItem = (items) => {
        Array.from(items).forEach((item) => item.classList.remove("selected"));
        if (currentIndex >= 0 && items[currentIndex]) {
            items[currentIndex].classList.add("selected");
            items[currentIndex].scrollIntoView({ block: "nearest" });
        }
    };

    const selectItem = (name) => {
        alert("선택된 이름: " + name);
        if (searchInput) searchInput.value = name;
        if (resultsList) resultsList.style.display = "none";
        currentIndex = -1;
    };

    // 🛠️ 6. [버그 수정 완료]: 누락되었던 renderResults 선언부를 다시 복구했습니다.
    const renderResults = (results, keyword) => {
        if (!resultsList) return;
        resultsList.innerHTML = "";
        currentIndex = -1;

        const directMatchedEvents = filterEventsByKeyword(keyword);

        if (results.length === 0 && directMatchedEvents.length === 0) {
            resultsList.innerHTML = `<li style="padding: 12px 20px; color:#888;">검색 결과가 없습니다 🐾</li>`;
            resultsList.style.display = "block";
            return;
        }

        // 품종 리스트 출력 구역
        results.forEach((pet) => {
            const li = document.createElement("li");
            li.classList.add("selectable-item");

            const isCat = pet.id && pet.id.startsWith("cat_");
            const calculatedType = isCat ? "cat" : "dog";
            const typeKorean = isCat ? "고양이" : "강아지";

            const nameKo = pet.nameKo || "이름 없음";
            const nameEn = pet.nameEn ? `(${pet.nameEn})` : "";

            li.innerHTML = `
                <strong>${nameKo}</strong> 
                <span style="color: #888; font-size: 14px;">${nameEn}</span>
                <span class="badge ${calculatedType}">${typeKorean}</span>
            `;

            li.dataset.nameKo = nameKo;
            li.addEventListener("click", () => selectItem(nameKo));
            resultsList.appendChild(li);
        });

        // 이벤트 데이터 수용 구역
        const detectedTypes = [
            ...new Set(
                results.map((pet) =>
                    pet.id && pet.id.startsWith("cat_") ? "cat" : "dog"
                )
            )
        ];
        const typeEvents = filterEventsByType(detectedTypes);
        const allMatchedEvents = [...typeEvents, ...directMatchedEvents];
        const uniqueEvents = allMatchedEvents.filter(
            (ev, index, self) => index === self.findIndex((t) => t.id === ev.id)
        );

        if (uniqueEvents.length > 0) {
            const divider = document.createElement("li");
            divider.style.padding = "0";
            divider.style.borderBottom =
                "1px dashed var(--theme-main, #4A90E2)";
            divider.style.margin = "6px 0";
            divider.style.cursor = "default";
            divider.addEventListener("click", (e) => e.stopPropagation());
            resultsList.appendChild(divider);

            uniqueEvents.forEach((event) => {
                const liEvent = document.createElement("li");
                liEvent.classList.add("event-item", "selectable-item");

                liEvent.innerHTML = `
                    <span style="color: var(--theme-main, #4A90E2); font-weight: bold; font-size: 12px; margin-right: 6px;">[${event.badge || "이벤트"}]</span>
                    <span style="font-size: 13px; color: #495057;">${event.title}</span>
                `;

                liEvent.addEventListener("click", (e) => {
                    e.stopPropagation();
                    if (event.link) location.href = event.link;
                });

                resultsList.appendChild(liEvent);
            });
        }

        resultsList.style.display = "block";
    };

    // 7. 실시간 검색 핸들러
    const handleSearch = (event) => {
        if (!resultsList) return;
        const keyword = event.target.value.trim();
        if (keyword === "") {
            resultsList.innerHTML = "";
            resultsList.style.display = "none";
            currentIndex = -1;
            return;
        }

        const filteredResults = filterPets(keyword);
        renderResults(filteredResults, keyword);
    };

    // 8. 인풋 키보드 방향키/엔터 제어 이벤트
    searchInput?.addEventListener("keydown", (e) => {
        if (!resultsList) return;
        const items = resultsList.querySelectorAll(".selectable-item");

        if (
            resultsList.style.display !== "none" &&
            items.length > 0 &&
            items[0].textContent &&
            !items[0].textContent.includes("검색 결과가 없습니다")
        ) {
            if (e.key === "ArrowDown") {
                e.preventDefault();
                currentIndex++;
                if (currentIndex >= items.length) currentIndex = 0;
                highlightItem(items);
                return;
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                currentIndex--;
                if (currentIndex < 0) currentIndex = items.length - 1;
                highlightItem(items);
                return;
            }
        }

        if (e.key === "Enter") {
            e.preventDefault();
            if (currentIndex >= 0 && items[currentIndex]) {
                const currentItem = items[currentIndex];

                if (currentItem instanceof HTMLElement) {
                    const selectedName = currentItem.dataset.nameKo;
                    if (selectedName) {
                        selectItem(selectedName);
                    } else {
                        currentItem.click();
                    }
                }
            } else {
                const currentInputValue = searchInput.value.trim();
                if (currentInputValue) {
                    selectItem(currentInputValue);
                }
            }
        }
    });

    // 9. 초기 활성화 구동단
    if (searchInput) {
        searchInput.addEventListener("input", handleSearch);
        searchInput.disabled = false;
        searchInput.placeholder = "댕댕이, 냥이 품종을 검색해보세요! 🐾";
    }

    // 10. 외부 영역 클릭 시 닫기
    document.addEventListener("click", (e) => {
        if (resultsList && !e.target.closest(".search-container")) {
            resultsList.style.display = "none";
        }
    });
</script>
