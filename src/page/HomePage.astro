---
import GuideBubble from "@/com/alert/CloudBubbleCSS.astro";
import DesktopScreen from "@/com/screen/DesktopScreen.astro";

import Header from "@/com/line/Header.astro";
import Footer from "@/com/line/Footer.astro";
import FilterBar from "@/com/search/FilterBar.astro";

const title = "Astro";
const description = "Astro My....";

const { user } = Astro.locals;

const isDebug = import.meta.env.PUBLIC_DEBUG_MODE === "true";
---

<!-- 1. 로딩 화면 컨테이너 (1200px 제약을 깨고 전체 화면을 채움) --><!-- 1. 로딩 화면 컨테이너: isDebug가 true이면 hidden 클래스를 추가하여 숨깁니다. --><!-- data-is-debug 속성을 통해 자바스크립트로 값을 전달합니다. -->
<div
    id="loading-screen"
    class:list={[{ hidden: isDebug }]}
    data-is-debug={isDebug}
>
    <!-- 글로벌 플래시 오버레이, 전체화면 -->
    <div
        class="global-flash-overlay pointer-events-none fixed inset-0 z-[100006] bg-white opacity-0 transition-opacity duration-500"
    >
    </div>

    <!-- 안내 말풍선 컴포넌트 -->
    <GuideBubble id="audio-guide-bubble" />

    <!-- 추출하여 단독으로 배치한 DesktopScreen -->
    <div id="app-view-container" class="min-h-screen w-full">
        <DesktopScreen />
    </div>
</div>

<!-- 2. 실제 메인 콘텐츠 영역 (자동으로 1200px 중앙 정렬 적용됨) -->
<!-- 2. 실제 메인 콘텐츠 영역: isDebug가 true이면 hidden 클래스를 적용하지 않아 바로 보여줍니다. -->
<div id="main-content" class:list={[{ hidden: !isDebug }]}>
    <Header user={user} searchWidth={"600px"} searchHeight={"46px"} />
    <main>
        <p>여기는 효과가 끝난 뒤 나타나는 1200px 너비의 메인 화면입니다.</p>
        <div style="width: 728px;">
            <FilterBar />
        </div>
    </main>
    <Footer />
</div>

<style>
    /* ==========================================================================
        로딩 스크린 레이아웃 및 레이어 순서 정리
    ========================================================================== */
    #loading-screen2 {
        position: fixed; /* 브라우저 창 기준으로 화면 고정 */
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--background-color, #ffffff);
        z-index: 100000; /* 메인 페이지보다 위에 표시 */
    }

    #loading-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%; /* 100vw 대신 100%로 변경 (스크롤바 너비 제외) */
        height: 100%; /* 100vh 대신 100%로 변경 (fixed 구조에서 더 안정적) */
        background-color: var(--background-color, #ffffff);
        z-index: 100000;

        overflow: hidden; /* 내부 콘텐츠가 넘치더라도 스크롤 바를 강제로 숨김 */
    }

    /* 메인 콘텐츠 초기 상태 숨김 */
    #main-content {
        transition: opacity 0.5s ease;
    }

    .hidden {
        opacity: 0;
        position: absolute;
        width: 100%;
        pointer-events: none;
    }
</style>

<script is:inline>
    function initializeApp() {
        const loadingScreen = document.getElementById("loading-screen");

        // 1. 디버그 모드인지 HTML 데이터 속성에서 확인
        const isDebug = loadingScreen?.dataset.isDebug === "true";

        // 2. 디버그 모드라면 아래의 오디오 설정 및 이벤트를 등록하지 않고 즉시 종료
        if (isDebug) {
            return;
        }

        // 오디오 파일 설정
        const shutterSound = new Audio("/sound/shutter.mp3");
        shutterSound.preload = "auto";

        // const loadingScreen = document.getElementById("loading-screen");
        const mainContent = document.getElementById("main-content");
        const flashOverlay = document.querySelector(".global-flash-overlay");
        const guideBubble = document.getElementById("audio-guide-bubble");
        const toggleWrapper =
            document.getElementById("absolute-theme-wrapper") ||
            document.querySelector(".top-theme-toggle");

        let flashCount = 0;
        let flashInterval;
        let isStarted = false;

        // 플래시 및 화면 전환 트리거 함수
        function triggerFlash() {
            if (!flashOverlay) return;
            flashCount++;

            // 플래시가 3번 터진 후 전체 로딩 창을 걷어내고 메인화면을 보여줌
            if (flashCount > 3) {
                clearInterval(flashInterval);
                flashOverlay.remove();

                // 셔터 효과 완료 후 메인화면으로 정식 전환
                if (loadingScreen && mainContent) {
                    loadingScreen.style.opacity = "0";
                    loadingScreen.style.transition = "opacity 0.5s ease";
                    setTimeout(() => {
                        loadingScreen.style.display = "none";
                        mainContent.classList.remove("hidden");
                    }, 500);
                }
                return;
            }

            shutterSound.currentTime = 0;
            shutterSound
                .play()
                .catch((err) =>
                    console.error("❌ 오디오 재생 거부:", err.name)
                );

            // opacity 조절로 플래시 효과 표현
            flashOverlay.classList.remove("opacity-0");
            flashOverlay.classList.add("opacity-100");

            setTimeout(() => {
                flashOverlay.classList.remove("opacity-100");
                flashOverlay.classList.add("opacity-0");
            }, 200);
        }

        const startEffect = (e) => {
            if (isStarted) return;
            isStarted = true;

            if (guideBubble) {
                // 커스텀 fade-out 스타일 적용
                guideBubble.classList.add("guide-bubble-fade-out");
                setTimeout(() => guideBubble.remove(), 400);
            }

            triggerFlash();
            flashInterval = setInterval(triggerFlash, 3000);

            window.removeEventListener("click", startEffect);
        };

        // 화면 클릭 시 셔터 이벤트 연동
        window.addEventListener("click", startEffect);

        if (toggleWrapper) {
            toggleWrapper.addEventListener(
                "click",
                (e) => {
                    if (!isStarted) startEffect(e);
                },
                true
            );
        }
    }

    // 초기 로드 및 Astro 페이지 전환 시 실행
    initializeApp();
    document.addEventListener("astro:page-load", initializeApp);
</script>
