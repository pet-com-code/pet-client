{
    // ======== Editor 설정 =============================
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // ======== Prettier 설정 (에디터 전역 포맷터 지정) =================
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    // ======== 언어별 포맷터 명시 ============================
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // ======== 🚀 Astro 전용 설정 =============================
    "[astro]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },

    // ======== Astro 확장 프로그램 충돌 방지 =====================
    "astro.format.enable": false
}
